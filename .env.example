NODE_VERSION=20.19.0

# Canonical production origin used at build time.
NEXT_PUBLIC_SITE_URL=https://jipcalc.co.kr

NEXT_TELEMETRY_DISABLED=1

# Optional Search Console verification value.
GOOGLE_SITE_VERIFICATION=

# Kakao AdFit placement flags. Set to false, 0, off, or no to disable.
NEXT_PUBLIC_ADFIT_ENABLE_RESULT_PRIMARY=true
NEXT_PUBLIC_ADFIT_ENABLE_MID_CONTENT=true
NEXT_PUBLIC_ADFIT_ENABLE_END=true
NEXT_PUBLIC_ADFIT_ENABLE_DESKTOP_RAIL=true

# Kakao AdFit unit IDs. Register real values in Render only; do not commit DAN IDs.
NEXT_PUBLIC_ADFIT_MOBILE_RECTANGLE_IMAGE=
NEXT_PUBLIC_ADFIT_MOBILE_BANNER=
NEXT_PUBLIC_ADFIT_MOBILE_THIN_BANNER=
NEXT_PUBLIC_ADFIT_DESKTOP_WEB_BANNER=
NEXT_PUBLIC_ADFIT_DESKTOP_RIGHT_TOP=
